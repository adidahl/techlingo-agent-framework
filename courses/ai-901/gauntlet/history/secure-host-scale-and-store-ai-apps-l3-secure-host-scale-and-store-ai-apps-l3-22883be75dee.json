        "payload": {
          "import_key": "secure-host-scale-and-store-ai-apps-l3-q1",
          "question_type": "multiple_choice",
          "question_text": "A healthcare diagnostic app uses medical images. The app service needs a stored key, but doctors need different access to model data. Which approach should set the doctors' permissions?",
          "options": {
            "options": [
              {
                "text": "Azure Key Vault",
                "is_correct": false,
                "error_type": "Confuses employee permissions with secret storage",
                "rationale": "Key Vault stores the application's key as a secret. It does not assign different permissions to doctors.",
                "better_fit": "Use Key Vault to keep the app service's key out of code and GitHub.",
                "feedback": {
                  "intrinsic": "The key could be protected, but doctors would not receive the needed access levels.",
                  "instructional": "Protect keys in Key Vault; assign people permissions with Entra ID and RBAC."
                }
              },
              {
                "text": "Azure Entra ID with RBAC",
                "is_correct": true,
                "error_type": null,
                "rationale": "Doctors need permissions that differ by role. Entra ID with RBAC limits access to data and resources according to assigned roles.",
                "better_fit": null,
                "feedback": null
              },
              {
                "text": "A managed identity",
                "is_correct": false,
                "error_type": "Confuses application identity with user role permissions",
                "rationale": "A managed identity lets the app retrieve a secret securely at runtime. It does not set doctors' role-based access to data.",
                "better_fit": "Use a managed identity when the app service retrieves its stored key from Key Vault.",
                "feedback": {
                  "intrinsic": "The application could get its key, while doctor permissions would remain unset.",
                  "instructional": "Managed identity serves the application; RBAC serves role-based permissions."
                }
              },
              {
                "text": "An API key",
                "is_correct": false,
                "error_type": "Confuses endpoint authentication with role-based authorization",
                "rationale": "An API key authenticates a request to an endpoint. It does not give different doctors different data permissions.",
                "better_fit": "Use an API key when an application calls an endpoint and must authenticate that call.",
                "feedback": {
                  "intrinsic": "One key would not separate doctors by their assigned access.",
                  "instructional": "A key authenticates a call. RBAC authorizes access by role."
                }
              }
            ],
            "blooms_level": "Analyzing/Evaluating",
            "original_question_type": "single_choice",
            "concept_id": "entra-id-and-rbac",
            "item_key": "secure-host-scale-and-store-ai-apps/entra-id-and-rbac/r5/v1",
            "rung": 5,
            "variant": 1,
            "module_key": "7-get-started-with-ai-in-azure",
            "lesson_key": "secure-host-scale-and-store-ai-apps",
            "learning_status": "new"
          },
          "correct_answer": "1",
          "explanation": "Correct. Doctors' different permissions should be assigned through Entra ID with RBAC.",
          "points": 1
        }
      },
