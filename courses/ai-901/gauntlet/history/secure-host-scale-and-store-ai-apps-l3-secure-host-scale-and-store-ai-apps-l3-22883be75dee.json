          "import_key": "secure-host-scale-and-store-ai-apps-l3-q4",
          "question_type": "multiple_choice",
          "question_text": "A manufacturing team packages its predictive-maintenance workloads as many containers. It needs one service to manage those workloads together. Which choice best fits?",
          "options": {
            "options": [
              {
                "text": "Azure App Service",
                "is_correct": false,
                "error_type": "Confuses container orchestration with web app hosting",
                "rationale": "App Service hosts web apps, APIs, and background jobs. It is not the service described for orchestrating many containers.",
                "better_fit": "Use App Service when quickly hosting a web app, API, or background job.",
                "feedback": {
                  "intrinsic": "The containers would not be managed by the service intended for large container workloads.",
                  "instructional": "Choose AKS when the central need is orchestrating many containers."
                }
              },
              {
                "text": "Scale out",
                "is_correct": false,
                "error_type": "Confuses capacity adjustment with workload orchestration",
                "rationale": "Scale out adds more app instances. It does not manage a collection of containerized workloads.",
                "better_fit": "Use scale out when request volume requires additional app copies.",
                "feedback": {
                  "intrinsic": "The team could add copies without organizing its container workloads.",
                  "instructional": "Scaling changes capacity; AKS orchestrates containers."
                }
              },
              {
                "text": "A virtual machine",
                "is_correct": false,
                "error_type": "Confuses a host environment with a container orchestrator",
                "rationale": "A virtual machine is a host that provides compute, memory, and networking. It is not the service that orchestrates many containers.",
                "better_fit": "Use a virtual machine when an application needs a cloud host environment.",
                "feedback": {
                  "intrinsic": "The workloads would have a host, but no orchestrator for managing them together.",
                  "instructional": "A VM is a host. AKS manages large numbers of containerized workloads."
                }
              },
              {
                "text": "Azure Kubernetes Service",
                "is_correct": true,
                "error_type": null,
                "rationale": "AKS orchestrates many containerized workloads. That directly matches a team that needs to manage many containers together.",
                "better_fit": null,
                "feedback": null
              }
            ],
            "blooms_level": "Analyzing/Evaluating",
            "original_question_type": "single_choice",
            "concept_id": "hosts-containers-aks-and-app-service",
