          "question_type": "multiple_choice",
          "question_text": "A finance fraud-detection service has one busy app instance. Its engineer wants that same instance to have more processing power, not more copies. Which choices fit? Select all that apply.",
          "options": {
            "options": [
              {
                "text": "Use scale up",
                "is_correct": true,
                "error_type": null,
                "rationale": "Scale up is vertical scaling of an existing instance. It matches the requirement for more power without more copies.",
                "better_fit": null,
                "feedback": null
              },
              {
                "text": "Increase its CPU",
                "is_correct": true,
                "error_type": null,
                "rationale": "Scale up increases CPU or memory on an existing instance. More CPU gives that same copy more processing capacity.",
                "better_fit": null,
                "feedback": null
              },
              {
                "text": "Increase its memory",
                "is_correct": true,
                "error_type": null,
                "rationale": "More memory is another form of scale up. It changes resources on the existing instance rather than adding copies.",
                "better_fit": null,
                "feedback": null
              },
              {
                "text": "Use scale out",
                "is_correct": false,
                "error_type": "Confuses vertical scaling with horizontal scaling",
                "rationale": "Scale out adds more instances. The engineer specifically wants to keep one instance and increase its resources.",
                "better_fit": "Use scale out when additional copies of the application are wanted.",
                "feedback": {
                  "intrinsic": "The service would gain more copies, contrary to the engineer's stated need.",
                  "instructional": "Choose scale up for more CPU or memory on one existing instance."
                }
              }
            ],
            "blooms_level": "Analyzing/Evaluating",
            "original_question_type": "multi_choice",
