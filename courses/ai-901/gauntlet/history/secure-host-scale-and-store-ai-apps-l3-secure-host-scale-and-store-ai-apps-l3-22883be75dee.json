                "better_fit": null,
                "feedback": null
              },
              {
                "text": "Azure SQL Database only",
                "is_correct": false,
                "error_type": "Confuses mission-critical workloads with global real-time data",
                "rationale": "Azure SQL Database is described for mission-critical workloads. Azure Cosmos DB is the option described for real-time globally distributed data.",
                "better_fit": "Choose Azure SQL Database when the key requirement is a mission-critical workload.",
                "feedback": {
                  "intrinsic": "The company could overlook the storage option identified for real-time global distribution.",
                  "instructional": "For real-time data across global locations, select Azure Cosmos DB and persistent storage."
                }
              },
              {
                "text": "Persistent data storage",
                "is_correct": true,
                "error_type": null,
                "rationale": "Persistent storage keeps information available for later use. The company needs transaction data to remain available across locations.",
                "better_fit": null,
                "feedback": null
              },
              {
                "text": "Real-time global distribution",
                "is_correct": true,
                "error_type": null,
                "rationale": "Real-time global distribution is the capability described for Azure Cosmos DB. It directly matches the stated availability need.",
                "better_fit": null,
                "feedback": null
              }
            ],
            "blooms_level": "Analyzing/Evaluating",
