        "payload": {
          "import_key": "azure-cloud-services-l3-q2",
          "question_type": "multiple_choice",
          "question_text": "A retail team is deciding how to host its product-recommendation web app. It can rent cloud computers or use a ready-made app platform, and it does not want to manage servers. Which choice best fits?",
          "options": {
            "options": [
              {
                "text": "Compute",
                "is_correct": false,
                "error_type": "Confuses cloud computers with managed hosting",
                "rationale": "Compute is like renting cloud computers for workloads. The scenario favors managed hosting instead of managing servers.",
                "better_fit": "Choose this when the team needs adjustable capacity to run a workload.",
                "feedback": {
                  "intrinsic": "The team could rent capacity but still face management work it wants to avoid.",
                  "instructional": "Compute supplies cloud computers; App Services provide managed hosting."
                }
              },
              {
                "text": "App Services",
                "is_correct": true,
                "error_type": null,
                "rationale": "Correct. The team prefers a ready-made platform without server management. App Services provide that managed hosting approach.",
                "better_fit": null,
                "feedback": null
              },
              {
                "text": "Storage",
                "is_correct": false,
                "error_type": "Confuses hosting choice with data persistence",
                "rationale": "Storage retains data but does not decide how the web app is hosted. The decision point is the hosting model.",
                "better_fit": "Choose this when product images, data, or backups must be retained.",
                "feedback": {
                  "intrinsic": "The team could preserve data without solving application hosting.",
                  "instructional": "Storage is for persistence; App Services address managed hosting."
                }
              },
              {
                "text": "Networking",
                "is_correct": false,
                "error_type": "Confuses server management with connectivity",
                "rationale": "Networking handles secure communication, not managed server operation. It does not satisfy the team's hosting preference.",
                "better_fit": "Choose this when the web app must securely connect to other resources.",
                "feedback": {
                  "intrinsic": "The app could have connectivity while its hosting decision remains unresolved.",
                  "instructional": "Networking solves connectivity needs; App Services solve managed hosting needs."
                }
              }
            ],
            "blooms_level": "Analyzing/Evaluating",
            "original_question_type": "single_choice",
            "concept_id": "azure-app-services",
