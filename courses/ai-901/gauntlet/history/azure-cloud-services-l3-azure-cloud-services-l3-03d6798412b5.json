          "import_key": "azure-cloud-services-l3-q1",
          "question_type": "multiple_choice",
          "question_text": "A manufacturing team needs two cloud resources to communicate safely while its maintenance databases remain available later. Which choices address only the communication problem? Select all that apply.",
          "options": {
            "options": [
              {
                "text": "Networking between the resources",
                "is_correct": true,
                "error_type": null,
                "rationale": "Correct. Networking connects cloud resources to each other. It directly addresses the communication problem.",
                "better_fit": null,
                "feedback": null
              },
              {
                "text": "Storage to make the resources communicate",
                "is_correct": false,
                "error_type": "Confuses persistence with communication",
                "rationale": "Storage preserves the maintenance databases but does not connect the resources. The question isolates the communication requirement.",
                "better_fit": "Choose this for the databases that must remain available later.",
                "feedback": {
                  "intrinsic": "The databases could be retained while the resources remain unable to communicate.",
                  "instructional": "Storage persists databases; networking connects resources."
                }
              },
              {
                "text": "Compute to create the connection",
                "is_correct": false,
                "error_type": "Confuses execution with connectivity",
                "rationale": "Compute runs workloads but does not provide the secure connection. The scenario's decision point is communication between resources.",
                "better_fit": "Choose this when a maintenance workload needs cloud execution capacity.",
                "feedback": {
                  "intrinsic": "More capacity would not necessarily establish communication.",
                  "instructional": "Compute executes workloads; networking provides connectivity."
                }
              },
              {
                "text": "Secure, efficient connectivity",
                "is_correct": true,
                "error_type": null,
                "rationale": "Correct. This describes the required communication outcome. Networking provides that secure, efficient connectivity.",
                "better_fit": null,
                "feedback": null
              }
            ],
            "blooms_level": "Analyzing/Evaluating",
