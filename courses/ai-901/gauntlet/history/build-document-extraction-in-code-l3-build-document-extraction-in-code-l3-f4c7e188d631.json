          "import_key": "build-document-extraction-in-code-l3-q3",
          "question_type": "multiple_choice",
          "question_text": "An accounts-payable team receives invoice PDFs and must send CustomerName and InvoiceDate into its software automatically. Which approach best fits?",
          "options": {
            "options": [
              {
                "text": "Use prebuilt-audioSearch with the SDK.",
                "is_correct": false,
                "error_type": "Confuses invoice documents with audio input",
                "rationale": "prebuilt-audioSearch is for audio analysis. Invoice PDFs need the invoice analyzer.",
                "better_fit": "Use it when processing recordings or calls.",
                "feedback": {
                  "intrinsic": "The team would select analysis for the wrong content type and not follow the invoice flow.",
                  "instructional": "Match the analyzer to the input: use prebuilt-invoice for invoice PDFs."
                }
              },
              {
                "text": "Use the portal to inspect layout only.",
                "is_correct": false,
                "error_type": "Confuses portal testing with coded invoice extraction",
                "rationale": "The portal can help test analysis and inspect results visually. Inspecting layout alone does not automate sending extracted fields into an application.",
                "better_fit": "Use the portal to validate analyzer output before writing automation.",
                "feedback": {
                  "intrinsic": "The team would still need a person to inspect invoices rather than pass fields onward automatically.",
                  "instructional": "Use the Python SDK and prebuilt-invoice when invoice fields must be handled automatically."
                }
              },
              {
                "text": "Use basic OCR without invoice fields.",
                "is_correct": false,
                "error_type": "Confuses text recognition with schema-based invoice extraction",
                "rationale": "Basic OCR recognizes printed text but does not understand meaning or relationships. The team needs specific invoice fields such as CustomerName and InvoiceDate.",
                "better_fit": "Use basic OCR when only editable and searchable printed text is needed.",
                "feedback": {
                  "intrinsic": "The team could get text but not the structured invoice values needed for its workflow.",
                  "instructional": "Use the invoice analyzer to return named fields, not only recognized text."
                }
              },
              {
                "text": "Use prebuilt-invoice with the Python SDK.",
                "is_correct": true,
                "error_type": null,
                "rationale": "prebuilt-invoice is designed for invoice analysis, and the Python SDK supports coded submission and returned fields. This fits automatic handling of invoice PDFs.",
                "better_fit": null,
                "feedback": null
              }
            ],
            "blooms_level": "Analyzing/Evaluating",
            "original_question_type": "single_choice",
