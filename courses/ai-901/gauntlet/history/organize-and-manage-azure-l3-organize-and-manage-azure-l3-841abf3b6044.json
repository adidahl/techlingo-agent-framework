        "payload": {
          "import_key": "organize-and-manage-azure-l3-q3",
          "question_type": "multiple_choice",
          "question_text": "A finance team must reduce an existing fraud-detection resource's cost while preserving an acceptable level of performance. Which decision best fits?",
          "options": {
            "options": [
              {
                "text": "Move it to a resource group",
                "is_correct": false,
                "error_type": "Confuses setting with container",
                "rationale": "A resource group organizes related resources for management. It does not set the resource's cost-performance balance.",
                "better_fit": "Use this when organizing related resources for shared management.",
                "feedback": {
                  "intrinsic": "Resources could be reorganized without solving the trade-off.",
                  "instructional": "Use performance tier when weighing cost and performance."
                }
              },
              {
                "text": "Choose a performance tier",
                "is_correct": true,
                "error_type": null,
                "rationale": "Performance tier is the setting associated with both cost and performance. It directly fits the stated trade-off.",
                "better_fit": null,
                "feedback": null
              },
              {
                "text": "Create another subscription",
                "is_correct": false,
                "error_type": "Confuses setting with billing container",
                "rationale": "A subscription provides billing, quota, and access boundaries. It is not the resource's performance setting.",
                "better_fit": "Use this when a separate billing or quota boundary is needed.",
                "feedback": {
                  "intrinsic": "A new billing container would not adjust resource performance.",
                  "instructional": "Performance tier is the setting related to cost and performance."
                }
              },
              {
                "text": "Change its resource type",
                "is_correct": false,
                "error_type": "Confuses setting with resource behavior",
                "rationale": "Resource type defines behavior and capabilities. The decision concerns an existing resource's cost-performance trade-off.",
                "better_fit": "Use this when the kind of Azure resource must change.",
                "feedback": {
                  "intrinsic": "The resource itself could change without addressing its tier.",
                  "instructional": "Choose a performance tier for the cost-performance decision."
                }
              }
            ],
            "blooms_level": "Analyzing/Evaluating",
            "original_question_type": "single_choice",
