          "question_type": "multiple_choice",
          "question_text": "A manufacturer is expanding a predictive-maintenance solution to several environments and needs repeatable deployment, clearer governance, and cost control. Which choices best support that goal? Select all that apply.",
          "options": {
            "options": [
              {
                "text": "Use scripts or templates for deployment",
                "is_correct": true,
                "error_type": null,
                "rationale": "Scripts and templates create resources repeatedly across environments. They reduce manual errors and improve reliability.",
                "better_fit": null,
                "feedback": null
              },
              {
                "text": "Use one resource as the folder",
                "is_correct": false,
                "error_type": "Confuses resource with resource group",
                "rationale": "A resource is an individual service or object. It is not the folder-like container for related assets.",
                "better_fit": "Use this when referring to one created item such as a database.",
                "feedback": {
                  "intrinsic": "Related assets would lack the intended shared-management container.",
                  "instructional": "Use a resource group as the folder-like container and a resource as an individual item."
                }
              },
              {
                "text": "Organize related assets in resource groups",
                "is_correct": true,
                "error_type": null,
                "rationale": "Resource groups organize related assets for joint management. They support policies, monitoring, and governance.",
                "better_fit": null,
                "feedback": null
              },
              {
                "text": "Use subscriptions for cost boundaries",
                "is_correct": true,
                "error_type": null,
                "rationale": "Subscriptions set cost, quota, and access-control boundaries. They support cost control.",
                "better_fit": null,
                "feedback": null
              }
