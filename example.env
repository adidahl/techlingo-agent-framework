# Copy to ".env" and fill in your key
OPENAI_API_KEY=your_openai_api_key_here

# Required by Microsoft Agent Framework OpenAIChatClient
OPENAI_CHAT_MODEL_ID=gpt-4o-mini

# --- LLM backend selection (optional) ---
# openai (default) | claude-code | codex  — CLI flag --backend wins over this.
# claude-code/codex run on the logged-in subscription seats ($0 marginal);
# check with: python main.py doctor
#TECHLINGO_LLM_BACKEND=claude-code
#CLAUDE_CODE_MODEL=sonnet
# Thinking budget for claude-code calls (low|medium|high). Unset = CLI default.
# Complex lesson calls think for MINUTES at the default; try medium for speed.
#CLAUDE_CODE_EFFORT=medium
#CODEX_MODEL=
# Parallel per-lesson LLM calls (default 4; 2-3 recommended on subscription seats)
#TECHLINGO_MAX_CONCURRENCY=3
# Per-completion timeout in seconds (default 1200; big A2/A4 lesson calls can need >10 min on CLI backends)
#TECHLINGO_LLM_TIMEOUT_S=1200


