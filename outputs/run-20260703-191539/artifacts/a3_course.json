        {
          "title": "Tokens, vectors, and embeddings",
          "slo": "Explain how text is split into tokens and turned into embeddings with help from a transformer.",
          "exercises": [
            {
              "blooms_level": "Remembering",
              "question_type": "single_choice",
              "prompt": "What is a token?",
              "options": [
                {
                  "text": "A small piece of text",
                  "is_correct": true,
                  "error_type": null,
                  "rationale": null,
                  "better_fit": null,
                  "feedback": null
                },
                {
                  "text": "A full conversation history",
                  "is_correct": false,
                  "error_type": "Too broad",
                  "rationale": "A token is smaller than a full conversation history.",
                  "better_fit": "A long record of messages in a chat.",
                  "feedback": null
                },
                {
                  "text": "A tool used by agents",
                  "is_correct": false,
                  "error_type": "Wrong concept",
                  "rationale": "A token is text, not a tool.",
                  "better_fit": "A tool an agent can use.",
                  "feedback": null
                },
                {
                  "text": "A final answer only",
                  "is_correct": false,
                  "error_type": "Incorrect definition",
                  "rationale": "A token is a small piece of text, not only a final answer.",
                  "better_fit": "The last response in a chat.",
                  "feedback": null
                }
              ],
              "feedback_for_correct": "Correct. Tokens are small pieces of text."
            },
            {
              "blooms_level": "Understanding",
              "question_type": "multi_choice",
              "prompt": "What happens to text in this process?",
              "options": [
                {
                  "text": "It is split into tokens",
                  "is_correct": true,
                  "error_type": null,
                  "rationale": "Text first gets split into tokens.",
                  "better_fit": null,
                  "feedback": null
                },
                {
                  "text": "It is turned into embeddings",
                  "is_correct": true,
                  "error_type": null,
                  "rationale": "Text is then turned into embeddings.",
                  "better_fit": null,
                  "feedback": null
                },
                {
                  "text": "It becomes a tool",
                  "is_correct": false,
                  "error_type": "Category error",
                  "rationale": "Text does not become a tool in this process.",
                  "better_fit": "When software is turned into a tool for use.",
                  "feedback": null
                },
                {
                  "text": "It stops being text forever",
                  "is_correct": false,
                  "error_type": "Overstated",
                  "rationale": "The text is transformed for processing, but the idea is still about text being split and turned into embeddings.",
                  "better_fit": "A permanent change where something no longer exists as text.",
                  "feedback": null
                }
              ],
              "feedback_for_correct": "Correct. Text is split into tokens and turned into embeddings."
            },
            {
              "blooms_level": "Understanding",
              "question_type": "true_false",
              "prompt": "Mark true or false.",
              "statement": "A transformer helps turn text into embeddings.",
              "correct_answer": true,
              "feedback_for_correct": "Correct. A transformer helps with embeddings.",
              "feedback_for_incorrect": {
                "intrinsic": "The statement is true.",
                "instructional": "Text is split into tokens and then turned into embeddings with help from a transformer."
              }
            },
            {
              "blooms_level": "Applying",
              "question_type": "fill_gaps",
              "prompt": "Complete the sentence.",
              "parts": [
                {
                  "type": "text",
                  "text": "Text is split into "
                },
                {
                  "type": "gap",
                  "accepted_answers": [
                    "tokens"
                  ],
                  "placeholder": "..."
                },
                {
                  "type": "text",
                  "text": " before it is turned into embeddings."
                }
              ]
            },
            {
              "blooms_level": "Analyzing/Evaluating",
              "question_type": "rearrange",
              "prompt": "Arrange the following steps...",
              "word_bank": [
                "Text",
                "is",
                "split",
                "into",
                "tokens",
                "and",
                "turned",
                "into",
                "embeddings."
              ],
              "correct_order": [
                "Text",
                "is",
                "split",
                "into",
                "tokens",
                "and",
                "turned",
                "into",
                "embeddings."
              ]
            }
          ],
          "flashcards": [
            {
              "front": "What is a token?",
              "back": "A small piece of text.",
              "hint": "Text gets split up."
            },
            {
              "front": "What are embeddings?",
              "back": "A form text is turned into.",
              "hint": "Help from a transformer."
            }
          ]
        }
      ]
