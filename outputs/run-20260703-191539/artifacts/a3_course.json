{
  "title": "Introduction to generative AI and agents",
  "difficulty": "beginner",
  "modules": [
    {
      "title": "How generative AI works",
      "lessons": [
        {
          "title": "What generative AI is",
          "slo": "Describe generative AI as technology that can create human-like content using learned patterns, not magic.",
          "exercises": [
            {
              "blooms_level": "Remembering",
              "question_type": "single_choice",
              "prompt": "What is generative AI?",
              "options": [
                {
                  "text": "Technology that creates human-like content from learned patterns",
                  "is_correct": true,
                  "error_type": null,
                  "rationale": null,
                  "better_fit": null,
                  "feedback": null
                },
                {
                  "text": "A camera that only copies pictures",
                  "is_correct": false,
                  "error_type": "Copying confusion",
                  "rationale": "This describes copying images, not creating new content from learned patterns.",
                  "better_fit": "When a device only duplicates existing pictures.",
                  "feedback": null
                },
                {
                  "text": "A rule that blocks all new content",
                  "is_correct": false,
                  "error_type": "Misconception",
                  "rationale": "Generative AI creates content; it does not block all new content.",
                  "better_fit": "A content filter or restriction rule.",
                  "feedback": null
                },
                {
                  "text": "A person who writes every answer by hand",
                  "is_correct": false,
                  "error_type": "Human-only idea",
                  "rationale": "Generative AI is technology, not a person.",
                  "better_fit": "When a human writes answers without AI help.",
                  "feedback": null
                }
              ],
              "feedback_for_correct": "Correct. Generative AI creates new content using patterns it learned."
            },
            {
              "blooms_level": "Understanding",
              "question_type": "multi_choice",
              "prompt": "Which are examples of generative AI?",
              "options": [
                {
                  "text": "It can create human-like content",
                  "is_correct": true,
                  "error_type": null,
                  "rationale": "This matches the definition of generative AI.",
                  "better_fit": null,
                  "feedback": null
                },
                {
                  "text": "It uses learned patterns",
                  "is_correct": true,
                  "error_type": null,
                  "rationale": "Generative AI uses learned patterns to create content.",
                  "better_fit": null,
                  "feedback": null
                },
                {
                  "text": "It works like magic",
                  "is_correct": false,
                  "error_type": "Myth",
                  "rationale": "Generative AI is not magic; it works from learned patterns.",
                  "better_fit": "A casual way to talk about something surprising, not a technical definition.",
                  "feedback": null
                },
                {
                  "text": "It only repeats one fixed answer",
                  "is_correct": false,
                  "error_type": "Overly narrow",
                  "rationale": "Generative AI can create new human-like content, not only one fixed answer.",
                  "better_fit": "A simple rule-based system that always gives the same response.",
                  "feedback": null
                }
              ],
              "feedback_for_correct": "Correct. Generative AI creates content by using learned patterns."
            },
            {
              "blooms_level": "Understanding",
              "question_type": "true_false",
              "prompt": "Mark true or false.",
              "statement": "Generative AI creates human-like content using learned patterns.",
              "correct_answer": true,
              "feedback_for_correct": "Correct. That is what generative AI does.",
              "feedback_for_incorrect": {
                "intrinsic": "The statement is true.",
                "instructional": "Generative AI makes new content from patterns it learned, rather than magic."
              }
            },
            {
              "blooms_level": "Applying",
              "question_type": "fill_gaps",
              "prompt": "Complete the sentence.",
              "parts": [
                {
                  "type": "text",
                  "text": "Generative AI can create "
                },
                {
                  "type": "gap",
                  "accepted_answers": [
                    "human-like content"
                  ],
                  "placeholder": "content"
                },
                {
                  "type": "text",
                  "text": " using learned patterns."
                }
              ]
            },
            {
              "blooms_level": "Analyzing/Evaluating",
              "question_type": "rearrange",
              "prompt": "Reconstruct the sentence.",
              "word_bank": [
                "Generative",
                "AI",
                "creates",
                "human-like",
                "content",
                "using",
                "learned",
                "patterns."
              ],
              "correct_order": [
                "Generative",
                "AI",
                "creates",
                "human-like",
                "content",
                "using",
                "learned",
                "patterns."
              ]
            }
          ],
          "flashcards": [
            {
              "front": "What is generative AI?",
              "back": "Technology that creates human-like content.",
              "hint": "Uses learned patterns."
            },
            {
              "front": "Magic or patterns?",
              "back": "Patterns, not magic.",
              "hint": "Think learned patterns."
            }
          ]
